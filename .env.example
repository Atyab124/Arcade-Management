NODE_ENV=development
LOG_LEVEL=debug

# ───── Postgres ─────────────────────────────────────────────────────────
# Tenant-scoped role used by the API (RLS enforced). The migrations
# create an `arcade_app` role with no BYPASSRLS; in production point
# DATABASE_URL at that role. In local docker the default `arcade`
# superuser also works because FORCE ROW LEVEL SECURITY applies to owners.
DATABASE_URL=postgresql://arcade:arcade@localhost:5432/arcade?schema=public

# Admin/service role used by background workers and the webhook receiver,
# which legitimately need cross-tenant access. If unset, falls back to
# DATABASE_URL. In prod, point at a role with BYPASSRLS.
SERVICE_DATABASE_URL=postgresql://arcade:arcade@localhost:5432/arcade?schema=public

# ───── Redis ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ───── API ──────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-please
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ───── Web ──────────────────────────────────────────────────────────────
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# ───── Trengo (optional in dev — FakeTrengoClient used if TRENGO_TOKEN blank) ──
TRENGO_BASE_URL=https://app.trengo.com/api/v2
TRENGO_TOKEN=
TRENGO_WEBHOOK_SECRET=

# ───── Google Sheets sync (optional in dev — FakeSheetsSource if creds missing) ──
GOOGLE_APPLICATION_CREDENTIALS=./infra/secrets/gcp-service-account.json
SHEETS_SYNC_INTERVAL_MINUTES=15

# ───── WhatsApp / Compliance ────────────────────────────────────────────
WA_MARKETING_QUIET_HOUR_START=22
WA_MARKETING_QUIET_HOUR_END=8
WA_DEFAULT_LOCALE=en
