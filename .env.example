NODE_ENV=development
LOG_LEVEL=debug

# Postgres
DATABASE_URL=postgresql://arcade:arcade@localhost:5432/arcade?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
JWT_ACCESS_SECRET=replace-me-access
JWT_REFRESH_SECRET=replace-me-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Web
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# Trengo
TRENGO_BASE_URL=https://app.trengo.com/api/v2
TRENGO_TOKEN=
TRENGO_WEBHOOK_SECRET=

# Google Sheets sync
GOOGLE_APPLICATION_CREDENTIALS=./infra/secrets/gcp-service-account.json
SHEETS_SYNC_INTERVAL_MINUTES=15

# WhatsApp / Compliance
WA_MARKETING_QUIET_HOUR_START=22
WA_MARKETING_QUIET_HOUR_END=8
WA_DEFAULT_LOCALE=en
