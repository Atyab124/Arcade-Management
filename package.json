{
  "name": "arcade-management",
  "version": "1.0.0",
  "private": true,
  "description": "iFun City Arcade Management System — monorepo root",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' build && pnpm -r --filter='./apps/*' build",
    "dev": "pnpm -r --parallel --stream dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @arcade/db migrate",
    "db:seed": "pnpm --filter @arcade/db seed",
    "db:reset": "pnpm --filter @arcade/db reset"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "prettier": "^3.2.5",
    "typescript": "^5.4.3"
  }
}
