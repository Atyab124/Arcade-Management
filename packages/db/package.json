{
  "name": "@arcade/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "reset": "prisma migrate reset --force",
    "seed": "tsx src/seed.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@arcade/lib": "workspace:*",
    "@arcade/types": "workspace:*",
    "@prisma/client": "^5.12.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "prisma": "^5.12.0",
    "tsx": "^4.7.1"
  }
}
